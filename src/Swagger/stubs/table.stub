<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SwaggerUI</title>
    <style>
        * {
            box-sizing: border-box
        }

        html, body {
            margin: 0;
            padding: 0
        }

        body {
            font: 13px/1.65 -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
            color: #333;
            background: #fff;
            -webkit-font-smoothing: antialiased;
        }

        /* ---------- 顶栏 ---------- */
        :root {
            --hdr: 56px
        }

        body {
            padding-top: var(--hdr)
        }

        .hdr {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--hdr);
            z-index: 60;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 0 20px;
            background: #fff;
            border-bottom: 1px solid #e6ebf3;
        }

        /* 顶栏 logo：原始 SVG 为深色底专用（字是白色），
           白色背景上会“隐身”，所以外面套一块深色圆角底，并用 flex 保证垂直居中 */
        .hdr .link {
            display: inline-flex;
            align-items: center;
            flex: 0 0 auto;
            height: 40px;
            color: #173647; /* <- logo 文字颜色，改这一个值即可 */
            text-decoration: none
        }

        .hdr .link .logo {
            display: block;
            height: 34px;
            width: auto
        }

        .hdr .link:hover {
            color: #0b2231
        }

        /* 文档标题 / 描述归到左侧菜单顶部 */
        .sidebar .brand {
            padding: 0 14px 10px
        }

        .sidebar .brand #ver {
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
            font-size: 13.5px;
            font-weight: 600;
            color: #1f2329;
            line-height: 1.3;
            white-space: normal;
            word-break: break-word;
            overflow: hidden;
        }

        .sidebar .brand small {
            display: block;
            font-size: 11px;
            color: #98a2b3;
            font-weight: 400;
            line-height: 1.5;
            margin-top: 3px;
            white-space: normal;
            word-break: break-word;
            overflow-wrap: anywhere;
        }

        .hdr .tb {
            flex: 0 0 auto;
            min-width: 0
        }

        .hdr .tb.mb-base {
            flex: 1 1 320px;
            min-width: 150px;
            max-width: 520px
        }

        .hdr .tb.mb-base select {
            flex: 1 1 auto;
            width: auto;
            max-width: none;
            min-width: 120px
        }

        .hdr .acts-right {
            margin-left: auto;
            flex: 0 0 auto
        }

        .layout {
            display: flex;
            min-height: calc(100vh - var(--hdr));
            align-items: flex-start
        }

        /* ---------- 左侧导航 ---------- */
        .sidebar {
            width: 236px;
            flex: 0 0 236px;
            position: sticky;
            top: var(--hdr);
            height: calc(100vh - var(--hdr));
            overflow: auto;
            border-right: 1px solid #eef0f4;
            background: #fafbfc;
            padding: 14px 0 40px;
        }

        #q {
            display: block;
            margin: 12px 12px 8px;
            width: calc(100% - 24px);
            padding: 5px 8px;
            border: 1px solid #dcdfe6;
            border-radius: 3px;
            font-size: 12px;
            color: #333;
            background: #fff;
            outline: none;
        }

        #q:focus {
            border-color: #8fb4ee;
            box-shadow: 0 0 0 2px rgba(59, 125, 221, .1)
        }

        #nav .tag {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11.5px;
            color: #5f6b7a;
            padding: 12px 16px 5px;
            font-weight: 600;
            letter-spacing: .3px;
            cursor: pointer;
            user-select: none;
        }

        #nav .tag:hover {
            color: #1c4fa1
        }

        #nav .tag .caret {
            border-top-color: #a8b0bb
        }

        #nav .tag .g-count {
            margin-left: auto;
            font-size: 10.5px;
            color: #98a2b3;
            background: #eef1f5;
            border-radius: 8px;
            padding: 0 6px;
            line-height: 15px;
            font-weight: 400;
        }

        #nav a {
            display: flex;
            gap: 6px;
            align-items: center;
            padding: 5px 16px 5px 32px;
            color: #3d4652;
            text-decoration: none;
            font-size: 12.5px;
            border-left: 2px solid transparent;
        }

        #nav a span.t {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap
        }

        #nav a:hover {
            background: #f0f4fb
        }

        #nav a.active {
            background: #eaf1fd;
            border-left-color: #3b7ddd;
            color: #1c4fa1
        }

        .dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            flex: 0 0 5px;
            background: #c6cdd8
        }

        .dot.get {
            background: #1a9d63
        }

        .dot.post {
            background: #2f6fdb
        }

        .dot.put {
            background: #c98708
        }

        .dot.delete {
            background: #d64545
        }

        .dot.patch {
            background: #7a5af8
        }

        /* ---------- 正文 ---------- */
        /* 默认：内容在右侧区域水平居中，最大 1200px */
        .main {
            flex: 1;
            min-width: 0;
            padding: 26px 40px 120px;
            display: flex;
            justify-content: center
        }

        .doc {
            width: 100%;
            max-width: 1200px
        }

        /* 全屏：铺满整个剩余宽度 */
        html.full .main {
            justify-content: flex-start;
            padding: 26px 28px 120px
        }

        html.full .title {
            color: #3b4151;
            font-family: sans-serif;
            font-size: 36px;
            text-align: center
        }

        html.full .doc {
            max-width: none
        }

        /* ---------- 顶栏工具（Base / Token / 文档） ---------- */
        .tb {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: #5a6373;
            white-space: nowrap
        }

        .tb input, .tb select {
            border: 1px solid #dcdfe6;
            border-radius: 3px;
            padding: 5px 8px;
            font-size: 12px;
            color: #333;
            background: #fff;
            outline: none;
            font-family: inherit;
        }

        .tb input {
            width: 210px;
            font-family: ui-monospace, Consolas, monospace
        }

        .tb input#token {
            width: 150px
        }

        .tb select {
            width: auto;
            max-width: 220px
        }

        .tb input:focus, .tb select:focus {
            border-color: #8fb4ee;
            box-shadow: 0 0 0 2px rgba(59, 125, 221, .08)
        }

        .tb .sp {
            flex: 1
        }

        .tb.acts-right {
            margin-left: auto;
            gap: 6px
        }

        .hdr .tb input {
            width: 230px
        }

        .hdr .tb input#token {
            width: 160px
        }

        /* ---------- 标签分组 ---------- */
        .group {
            margin: 0 0 4px
        }

        .group-h {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 0 8px;
            cursor: pointer;
            user-select: none;
            border-bottom: 1px solid #e6ebf3;
            margin-bottom: 16px;
        }

        .group-h:hover .g-name {
            color: #1c4fa1
        }

        .g-name {
            font-size: 14px;
            font-weight: 600;
            color: #2b3440;
            letter-spacing: .2px
        }

        .g-count {
            font-size: 11px;
            color: #98a2b3;
            background: #f2f4f7;
            border-radius: 9px;
            padding: 0 7px;
            line-height: 17px;
            font-weight: 400
        }

        .group.collapsed .group-b {
            display: none
        }

        .caret {
            width: 0;
            height: 0;
            border-left: 4px solid transparent;
            border-right: 4px solid transparent;
            border-top: 5px solid #98a2b3;
            transition: transform .15s ease;
            flex: 0 0 auto;
        }

        .collapsed .caret {
            transform: rotate(-90deg)
        }

        .api {
            padding: 0 0 4px;
            margin: 0 0 18px;
            border-bottom: 1px dashed #f2f4f7
        }

        .api:last-child {
            border-bottom: 0;
            margin-bottom: 0
        }

        h2.api-title {
            font-size: 16px;
            font-weight: 600;
            margin: 0;
            color: #1f2329;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            cursor: pointer;
            user-select: none;
            padding: 2px 0;
        }

        h2.api-title:hover .api-name {
            color: #1c4fa1
        }

        .api-body {
            padding-top: 10px
        }

        .api.collapsed .api-body {
            display: none
        }

        .api-right {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 400;
            font-size: 11.5px;
            color: #6b7280
        }

        .auth-tog {
            display: flex;
            align-items: center;
            gap: 4px;
            cursor: pointer;
            white-space: nowrap
        }

        .auth-tog input {
            margin: 0;
            cursor: pointer
        }

        .badge {
            font-size: 11px;
            font-weight: 600;
            padding: 0 6px;
            border-radius: 3px;
            line-height: 17px;
            display: inline-block
        }

        .badge.auth {
            background: #fdf4e7;
            color: #b07000;
            border: 1px solid #f3e0be
        }

        .m {
            font-size: 11px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 3px;
            color: #fff;
            letter-spacing: .4px;
            line-height: 1.5
        }

        .m.get {
            background: #1a9d63
        }

        .m.post {
            background: #2f6fdb
        }

        .m.put {
            background: #c98708
        }

        .m.delete {
            background: #d64545
        }

        .m.patch {
            background: #7a5af8
        }

        .m.head, .m.options {
            background: #6b7280
        }

        .path {
            font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
            font-size: 12.5px;
            color: #6b7280;
            font-weight: 400
        }

        .desc {
            margin: 4px 0 16px;
            color: #6b7280;
            font-size: 12.5px;
            max-width: 820px
        }

        /* ---------- 文档表格 ---------- */
        .tbl {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin: 0 0 20px;
            background: #fff
        }

        .tbl td {
            border: 1px solid #e3e7ee;
            padding: 8px 10px;
            vertical-align: middle;
            word-break: break-word
        }

        .tbl .thead td {
            background: #eaf2fd;
            color: #2b3440;
            font-weight: 600
        }

        .tbl .th td {
            background: #f3f7fd;
            color: #4a5464;
            font-weight: 600
        }

        .tbl .lb {
            width: 150px;
            color: #4a5464;
            background: #fff
        }

        .tbl .grp td {
            background: #f7f9fc;
            color: #5a6373;
            font-weight: 600
        }

        .tbl .grp[data-act] td {
            cursor: pointer;
            user-select: none
        }

        .tbl .grp[data-act]:hover td {
            background: #eef4fc
        }

        .tbl .grp .grp-l {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            line-height: 1.3
        }

        .tbl .grp .grp-l .caret {
            flex: 0 0 auto
        }

        .tbl .grp.folded .caret {
            transform: rotate(-90deg)
        }

        .tbl .grp .cnt {
            font-weight: 400;
            color: #98a2b3;
            font-size: 11.5px;
            line-height: 1
        }

        .tbl .sub td:first-child {
            padding-left: 26px
        }

        .tbl .note {
            font-weight: 400;
            color: #8a929e;
            font-size: 11.5px;
            margin-left: 6px
        }

        .tbl .muted {
            color: #a0a7b2
        }

        .code {
            font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
            font-size: 12px;
            color: #3d4652
        }

        /* 表格内：全部展开/收起 */
        .fold-all {
            float: right;
            font-weight: 400;
            font-size: 11.5px;
            color: #2f6fdb;
            cursor: pointer;
            user-select: none;
            padding: 1px 6px;
            border: 1px solid #cfe0f8;
            border-radius: 3px;
            background: #fff;
        }

        .fold-all:hover {
            background: #eaf2fd
        }

        /* 描述列过长折叠 */
        .dcell {
            position: relative
        }

        .dcell .dtxt {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            padding-right: 38px
        }

        .dcell.open .dtxt {
            display: block;
            overflow: visible;
            padding-right: 0
        }

        .dmore {
            color: #2f6fdb;
            font-size: 11.5px;
            cursor: pointer;
            user-select: none;
            white-space: nowrap;
            position: absolute;
            right: 8px;
            bottom: 7px;
            background: #fff;
            padding-left: 4px;
        }

        .dcell.open .dmore {
            position: static;
            display: inline-block;
            margin-top: 2px;
            padding-left: 0
        }

        .dmore:hover {
            text-decoration: underline
        }

        /* ---------- 在线调试 ---------- */
        .try {
            border: 1px solid #e3e7ee;
            border-radius: 4px;
            margin: 0 0 20px;
            overflow: hidden
        }

        .try-h {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            padding: 8px 12px;
            background: #f7f9fc;
            border-bottom: 1px solid #e3e7ee;
            font-weight: 600;
            color: #2b3440;
            font-size: 12.5px;
            cursor: pointer;
            user-select: none;
        }

        .try-h:hover {
            background: #f1f6fd
        }

        .try-h .tl {
            display: flex;
            align-items: center;
            gap: 7px
        }

        .try-h .hint {
            font-weight: 400;
            color: #98a2b3;
            font-size: 11.5px
        }

        .try.collapsed .try-b {
            display: none
        }

        .try.collapsed .try-h {
            border-bottom: 0
        }

        .try-b {
            padding: 12px
        }

        .row {
            display: flex;
            gap: 8px;
            align-items: flex-start;
            margin-bottom: 10px
        }

        .row > label {
            width: 76px;
            flex: 0 0 76px;
            font-size: 12px;
            color: #5a6373;
            line-height: 28px
        }

        .row .ctl {
            flex: 1;
            min-width: 0
        }

        .row input[type=text], .row textarea {
            width: 100%;
            border: 1px solid #dcdfe6;
            border-radius: 3px;
            padding: 6px 8px;
            font: 12px/1.55 ui-monospace, SFMono-Regular, Consolas, monospace;
            color: #333;
            background: #fff;
            outline: none;
        }

        .row textarea {
            resize: vertical;
            min-height: 70px
        }

        .row input:focus, .row textarea:focus {
            border-color: #8fb4ee;
            box-shadow: 0 0 0 2px rgba(59, 125, 221, .08)
        }

        .row .req {
            color: #d64545;
            margin-left: 2px
        }

        .row .tip {
            font-size: 11.5px;
            color: #98a2b3;
            margin-top: 3px
        }

        .acts {
            display: flex;
            gap: 8px;
            align-items: center;
            margin-top: 2px
        }

        .btn {
            background: #2f6fdb;
            color: #fff;
            border: 0;
            border-radius: 3px;
            padding: 7px 16px;
            font-size: 12.5px;
            cursor: pointer;
            font-family: inherit
        }

        .btn:hover {
            background: #2a63c4
        }

        .btn:disabled {
            background: #a8bde2;
            cursor: not-allowed
        }

        .btn.ghost {
            background: #fff;
            color: #4a5464;
            border: 1px solid #dcdfe6
        }

        .btn.ghost:hover {
            background: #f7f9fc
        }

        .btn.mini {
            padding: 2px 8px;
            font-size: 11.5px
        }

        .resp {
            margin-top: 12px;
            border-top: 1px dashed #e8ecf2;
            padding-top: 10px;
            display: none
        }

        .resp-meta {
            display: flex;
            gap: 10px;
            align-items: center;
            margin-bottom: 8px;
            font-size: 12px;
            color: #6b7280;
            flex-wrap: wrap
        }

        .st {
            padding: 1px 7px;
            border-radius: 3px;
            color: #fff;
            font-weight: 600;
            font-size: 11.5px;
            background: #6b7280
        }

        .st.ok {
            background: #1a9d63
        }

        .st.redir {
            background: #2f6fdb
        }

        .st.warn {
            background: #c98708
        }

        .st.err {
            background: #d64545
        }

        pre.resp-body {
            margin: 0;
            background: #fafbfc;
            border: 1px solid #eef0f4;
            border-radius: 3px;
            padding: 10px;
            font: 12px/1.55 ui-monospace, SFMono-Regular, Consolas, monospace;
            color: #3d4652;
            max-height: 420px;
            overflow: auto;
            white-space: pre-wrap;
            word-break: break-all;
        }

        .err-tip {
            border: 1px solid #f3d1d1;
            background: #fdf5f5;
            color: #b53c3c;
            padding: 9px 11px;
            border-radius: 3px;
            font-size: 12px;
            line-height: 1.7
        }

        .warn-tip {
            display: none;
            margin: 0 0 10px;
            padding: 7px 10px;
            border: 1px solid #f6e2bd;
            background: #fdf8ee;
            color: #96650a;
            border-radius: 3px;
            font-size: 12px;
        }

        .err-tip code {
            background: #fdeaea;
            padding: 1px 4px;
            border-radius: 2px;
            font-size: 11.5px
        }

        .empty {
            padding: 60px 0;
            color: #98a2b3;
            text-align: center
        }

        .bucket {
            margin: 22px 0;
            padding: 12px 14px;
            border: 1px solid #f3d1d1;
            background: #fdf5f5;
            color: #b53c3c;
            border-radius: 3px;
            font-size: 12.5px;
            text-align: center
        }

        @media (max-width: 1280px) {
            .hdr .tb input#token {
                width: 110px
            }

            .hdr .tb select {
                max-width: 170px
            }
        }

        @media (max-width: 900px) {
            .sidebar {
                display: none
            }

            .main {
                padding: 16px 16px 80px
            }

            .tbl .lb {
                width: 110px
            }

            .hdr {
                padding: 0 12px;
                gap: 8px
            }

            .hdr .tb.mb-base {
                min-width: 96px;
                flex: 1 1 120px
            }

            .hdr .tb input {
                width: 150px
            }

            .hdr .tb input#token {
                width: 96px
            }

            .tb input {
                width: 150px
            }
        }
    </style>
    <script>
        // 布局偏好在首屏渲染前应用，避免切换时闪一下
        try {
            if (localStorage.getItem('apidoc.layout') === 'full') {
                document.documentElement.classList.add('full');
            }
        } catch (e) {
        }
    </script>
</head>
<body>
<header class="hdr">
    <a rel="noopener noreferrer" class="link" title="Swagger">
        <svg class="logo" viewBox="0 0 407 116" role="img" aria-label="Swagger" xmlns="http://www.w3.org/2000/svg">
            <g id="SW_TM-logo-on-dark">
                <g id="SW_In-Product" transform="translate(-0.301)">
                    <path id="Path_2936" data-name="Path 2936" fill="currentColor" d="M359.15,70.674h-.7V66.992h-1.26v-.6h3.219v.6H359.15Z"/>
                    <path id="Path_2937" data-name="Path 2937" fill="currentColor" d="M363.217,70.674,361.975,67.1h-.023q.05.8.05,1.494v2.083h-.636V66.391h.987l1.19,3.407h.017l1.225-3.407h.99v4.283H365.1V68.556c0-.213.006-.49.016-.832s.02-.549.028-.621h-.023l-1.286,3.571Z"/>
