                    <path id="Path_2962" data-name="Path 2962" fill="currentColor" d="M180.525,101.517a5.506,5.506,0,0,1,1.1.1l-.194,1.3a4.786,4.786,0,0,0-1.011-.127,2.46,2.46,0,0,0-1.917.911,3.318,3.318,0,0,0-.8,2.267v4.955h-1.4v-9.236h1.154l.16,1.71h.068a4.054,4.054,0,0,1,1.238-1.39,2.787,2.787,0,0,1,1.6-.49Z"/>
                    <path id="Path_2963" data-name="Path 2963" fill="currentColor" d="M187.363,109.936a4.506,4.506,0,0,0,.716-.055,4.387,4.387,0,0,0,.548-.114v1.07a2.5,2.5,0,0,1-.67.181,5,5,0,0,1-.8.072q-2.68,0-2.68-2.823v-5.494h-1.323V102.1l1.323-.582.59-1.972h.809v2.141h2.68v1.087h-2.68v5.435a1.869,1.869,0,0,0,.4,1.281A1.377,1.377,0,0,0,187.363,109.936Z"/>
                    <path id="Path_2964" data-name="Path 2964" fill="currentColor" d="M194.538,111.09a4.239,4.239,0,0,1-3.231-1.247,4.824,4.824,0,0,1-1.184-3.463,5.355,5.355,0,0,1,1.1-3.548,3.652,3.652,0,0,1,2.954-1.315,3.484,3.484,0,0,1,2.747,1.142,4.378,4.378,0,0,1,1.011,3.013v.885h-6.362a3.66,3.66,0,0,0,.822,2.469,2.843,2.843,0,0,0,2.2.843,7.431,7.431,0,0,0,2.949-.624v1.247a7.377,7.377,0,0,1-1.4.459,7.863,7.863,0,0,1-1.6.139Zm-.379-8.4a2.286,2.286,0,0,0-1.774.725,3.337,3.337,0,0,0-.779,2.006h4.828a3.072,3.072,0,0,0-.59-2.027,2.076,2.076,0,0,0-1.685-.706Z"/>
                    <path id="Path_2965" data-name="Path 2965" fill="currentColor" d="M206.951,109.683h-.076a3.287,3.287,0,0,1-2.9,1.407,3.427,3.427,0,0,1-2.819-1.239,5.452,5.452,0,0,1-1.006-3.522,5.542,5.542,0,0,1,1.011-3.548,3.4,3.4,0,0,1,2.814-1.264,3.361,3.361,0,0,1,2.883,1.365h.109l-.059-.665-.034-.649V97.809h1.4v13.113h-1.138Zm-2.8.236a2.551,2.551,0,0,0,2.078-.779,3.947,3.947,0,0,0,.644-2.516v-.3a4.638,4.638,0,0,0-.653-2.8,2.481,2.481,0,0,0-2.086-.839,2.14,2.14,0,0,0-1.883.957,4.76,4.76,0,0,0-.653,2.7,4.554,4.554,0,0,0,.649,2.671,2.194,2.194,0,0,0,1.906.906Z"/>
                    <path id="Path_2966" data-name="Path 2966" fill="currentColor" d="M220.712,101.534a3.435,3.435,0,0,1,2.827,1.243,6.653,6.653,0,0,1-.009,7.053,3.417,3.417,0,0,1-2.818,1.26,4,4,0,0,1-1.648-.333,3.094,3.094,0,0,1-1.251-1.023h-.1l-.295,1.188h-1V97.809h1.4V101q0,1.069-.068,1.921h.068a3.322,3.322,0,0,1,2.894-1.387Zm-.2,1.171a2.44,2.44,0,0,0-2.064.822,6.338,6.338,0,0,0,.017,5.553,2.464,2.464,0,0,0,2.081.839,2.158,2.158,0,0,0,1.922-.94,4.828,4.828,0,0,0,.632-2.7,4.645,4.645,0,0,0-.632-2.689,2.242,2.242,0,0,0-1.959-.885Z"/>
                    <path id="Path_2967" data-name="Path 2967" fill="currentColor" d="M225.758,101.686h1.5l2.023,5.267a20.188,20.188,0,0,1,.826,2.6h.067q.109-.431.459-1.471t2.288-6.4h1.5L230.452,112.2a5.253,5.253,0,0,1-1.378,2.212,2.932,2.932,0,0,1-1.934.653,5.659,5.659,0,0,1-1.264-.143V113.8a4.9,4.9,0,0,0,1.037.1,2.136,2.136,0,0,0,2.056-1.618l.514-1.314Z"/>
                </g>
            </g>
        </svg>

    </a>
    <div class="tb"></div>
    <div class="tb"><label for="docSel">文档</label><select id="docSel"></select></div>
    <div class="tb mb-base">
        <label for="base">Servers</label>
        <select id="base" spellcheck="false"></select>
    </div>
    <div class="tb"><label for="token">Token</label><input id="token" type="text" spellcheck="false"
                                                           placeholder="可留空"></div>
    <div class="tb acts-right">
        <button class="btn ghost mini" data-act="toggle-layout" id="layoutBtn" title="切换内容布局">全屏</button>
        <button class="btn ghost mini" data-act="expand-all">全部展开</button>
        <button class="btn ghost mini" data-act="collapse-all">全部收起</button>
    </div>
</header>
<div class="layout">
    <aside class="sidebar">
        <div class="brand"><span id="ver">API 接口文档</span><small id="desc"></small></div>
        <input id="q" type="text" placeholder="搜索接口 / 路径…" autocomplete="off">
        <nav id="nav"></nav>
    </aside>
    <main class="main">
        <div class="doc">
            <div id="doc">
                <div class="empty">加载中…</div>
            </div>
        </div>
    </main>
</div>

<script>
    (function () {
        'use strict';
        /* ============ 常量 ============ */
        // 同目录下的文档文件，按需增删，只写文件名即可
        var DOCS = ['api.json', 'admin.json'];
        var METHODS = ['get', 'post', 'put', 'patch', 'delete', 'head', 'options'];

        /* 文件名 -> 请求路径：统一补 / ，保证从当前页面所在的同目录下取到 */
        function docUrl(f) {
            f = String(f == null ? '' : f).trim();
            return f.charAt(0) === '/' ? f : '/' + f;
        }

        /* 文件名 -> 下拉展示名：去掉目录和 .json 后缀 */
        function docName(f) {
            return String(f == null ? '' : f).trim().split('/').pop().replace(/\.json$/i, '');
        }

        var LS_BASE = 'apidoc.base';
        var LS_TOKEN = 'apidoc.token';
        var SPEC = null;
        var LIST = [];
        var META = {};      // idx -> { path, method, hasBody, isGet }
        var SPEC_URL = '';

        /* ============ 工具 ============ */
        function esc(s) {
            return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
                return ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'})[c];
            });
        }

        function resolveRef(ref) {
            var parts = ref.replace(/^#\//, '').split('/');
            var cur = SPEC;
            for (var i = 0; i < parts.length; i++) {
                if (!cur) return {};
                cur = cur[parts[i]];
            }
            return cur || {};
        }

        // 展开 $ref / allOf
        function deref(s, depth) {
            depth = depth || 0;
            if (!s || typeof s !== 'object' || depth > 12) return s || {};
            if (s.$ref) return deref(resolveRef(s.$ref), depth + 1);
            if (Array.isArray(s.allOf)) {
                var merged = {properties: {}, required: []};
                for (var k in s) if (k !== 'allOf') merged[k] = s[k];
                s.allOf.forEach(function (sub) {
                    var r = deref(sub, depth + 1);
                    for (var k2 in r) {
                        if (k2 === 'properties') {
                            for (var p in r.properties) merged.properties[p] = r.properties[p];
                        } else if (k2 === 'required') {
                            if (Array.isArray(r.required)) merged.required = merged.required.concat(r.required);
                        } else if (merged[k2] === undefined) {
                            merged[k2] = r[k2];
                        }
                    }
                });
                return merged;
            }
            return s;
        }

        function typeLabel(s) {
            s = deref(s);
            if (!s || typeof s !== 'object') return '';
            if (s.type === 'array') return 'array&lt;' + (typeLabel(s.items || {}) || 'any') + '&gt;';
            if (Array.isArray(s.type)) return esc(s.type.join(' | '));
            if (s.type) return esc(s.type);
            if (s.properties) return 'object';
            if (s.oneOf) return 'oneOf';
            if (s.anyOf) return 'anyOf';
            return '';
        }

        function refNameOf(s) {
            return (s && typeof s === 'object' && typeof s.$ref === 'string')
                ? s.$ref.split('/').pop() : '';
        }

        // 描述优先 description，其次 title（但 title 若只是类名则忽略），最后枚举值
        function labelOf(p, refName) {
            if (!p) return '';
            var t = p.description || '';
            if (!t) {
                var ti = p.title || '';
                if (ti && ti !== refName) t = ti;
            }
            if (!t && Array.isArray(p.enum) && p.enum.length) {
                t = '枚举：' + p.enum.join(' / ');
            }
            return t;
        }

        // 兼容 hyperf 生成的两处怪癖：required 落在字段自身、字段名只有 title
        function isRequired(name, p, objRequired) {
            if (Array.isArray(objRequired) && objRequired.indexOf(name) > -1) return true;
            if (p && Array.isArray(p.required) && p.required.indexOf(name) > -1) return true;
            if (p && p.required === true) return true;
            return false;
        }

        function exampleOf(s) {
            s = deref(s);
            if (!s) return '';
            var v;
            if (s.example !== undefined) v = s.example;
            else if (s.default !== undefined) v = s.default;
            else if (Array.isArray(s.enum) && s.enum.length) v = s.enum[0];
            else return '';
            if (v !== null && typeof v === 'object') {
                try {
                    v = JSON.stringify(v);
                } catch (e) {
                    v = String(v);
                }
            }
            v = String(v);
            if (v.length > 80) v = v.slice(0, 80) + '…';
            return '<span class="code">' + esc(v) + '</span>';
        }

        function maxLenOf(s) {
            s = deref(s);
            var n = s.maxLength != null ? s.maxLength : (s.maxItems != null ? s.maxItems : null);
            return n == null ? '' : esc(n);
        }

        // 生成请求体示例
        function sample(s, depth) {
            depth = depth || 0;
            s = deref(s);
            if (!s || depth > 6) return null;
            if (s.example !== undefined) return s.example;
            if (s.default !== undefined) return s.default;
            if (Array.isArray(s.enum) && s.enum.length) return s.enum[0];
            if (s.type === 'array') return [sample(s.items || {}, depth + 1)];
            if (s.properties) {
                var o = {};
                Object.keys(s.properties).forEach(function (k) {
                    o[k] = sample(s.properties[k], depth + 1);
                });
                return o;
            }
            if (s.type === 'integer' || s.type === 'number') return 0;
            if (s.type === 'boolean') return false;
            if (s.type === 'string') return '';
            return null;
        }

        /* ============ 表格行 ============ */
        var GID = 0;                 // 结构分组自增 id
        var AUTO_FOLD_DEPTH = 1;     // 该深度起的嵌套结构默认收起（0 = 全部收起）
        var DESC_LIMIT = 90;         // 描述超过该字符数则折叠为 2 行
        // 描述单元格：过长时截断 + 展开/收起
        function descCell(text) {
            var t = text || '';
            if (t.length <= DESC_LIMIT) return '<td>' + t + '</td>';
            return '<td class="dcell"><div class="dtxt">' + t + '</div>' +
                '<span class="dmore" data-act="toggle-desc">展开</span></td>';
        }

        function schemaRows(schema, mode, depth, out, parentRequired, ancestors, gids) {
            ancestors = ancestors || [];
            gids = gids || [];
            var gattr = gids.length ? ' data-gids="' + gids.join(' ') + '"' : '';
            var s = deref(schema);
            var props = s.properties || {};
            var req = Array.isArray(s.required) ? s.required : (parentRequired || []);
            Object.keys(props).forEach(function (name) {
                var raw = props[name];
                var refName = refNameOf(raw);
                var p = deref(raw);
                var required = isRequired(name, p, req);
                var cols = [];
                cols.push('<td' + (depth ? ' style="padding-left:' + (10 + depth * 16) + 'px"' : '') + '>' + esc(name) + '</td>');
                cols.push('<td>' + (typeLabel(p) || '<span class="muted">—</span>') + '</td>');
                cols.push('<td>' + (required ? '是' : '否') + '</td>');
                if (mode === 'request') cols.push('<td>' + (maxLenOf(p) || '') + '</td>');
                cols.push(descCell(labelOf(p, refName) ? esc(labelOf(p, refName)) : ''));
                cols.push('<td>' + (exampleOf(p) || '') + '</td>');
                out.push('<tr' + gattr + '>' + cols.join('') + '</tr>');
                if (depth >= 6) return;
                // 找子结构（object / array of object / oneOf）
                var child = null, childRef = '';
                if (p.properties && Object.keys(p.properties).length) {
                    child = p;
                    childRef = refName;
                } else if (p.type === 'array') {
                    var rawItems = raw && raw.items;
                    childRef = refNameOf(rawItems);
                    var it = deref(rawItems || {});
                    if (it.properties && Object.keys(it.properties).length) child = it;
                } else if (p.oneOf && p.oneOf.length) {
                    childRef = refNameOf(raw && raw.oneOf && raw.oneOf[0]);
                    var first = deref(p.oneOf[0]);
                    if (first.properties) child = first;
                }
                // 循环引用保护：同一 schema 已展开过则不再递归
                if (!child || (childRef && ancestors.indexOf(childRef) > -1)) return;
                // 每个嵌套结构生成一个可折叠的分组行
                var gid = 'g' + (++GID);
                var n = Object.keys(child.properties || {}).length;
                out.push('<tr class="grp' + (depth >= AUTO_FOLD_DEPTH ? ' folded' : '') + '"' +
                    ' data-act="toggle-grp" data-gid="' + gid + '"' + gattr + '>' +
                    '<td colspan="' + (mode === 'request' ? 6 : 5) + '" style="padding-left:' + (10 + depth * 16) + 'px">' +
                    '<span class="grp-l"><i class="caret"></i><span class="gname">' + esc(name) +
                    ' 参数结构</span><span class="cnt">' + n + ' 项</span></span></td></tr>');
                schemaRows(child, mode, depth + 1, out, child.required || [],
                    childRef ? ancestors.concat([childRef]) : ancestors,
                    gids.concat([gid]));
            });
        }

        /* ============ 结构折叠（参数表内嵌套结构） ============ */

        // 表格标题右侧的「收起全部 / 展开全部」按钮（仅当表内存在可折叠结构时出现）
        function foldAllBtn(rows) {
            var has = rows.some(function (r) {
                return r.indexOf('data-act="toggle-grp"') > -1;
            });
            return has ? '<span class="fold-all" data-act="fold-table">收起全部</span>' : '';
        }

        // 按各分组行的 folded 状态重算行显隐，天然支持多层嵌套
        function recalcFold(tbl) {
            var folded = {};
            Array.prototype.forEach.call(tbl.querySelectorAll('tr.grp[data-gid]'), function (t) {
                if (t.classList.contains('folded')) folded[t.dataset.gid] = 1;
            });
            Array.prototype.forEach.call(tbl.querySelectorAll('tr[data-gids]'), function (r) {
                var gs = (r.getAttribute('data-gids') || '').split(' ');
                var hide = false;
                for (var i = 0; i < gs.length; i++) {
                    if (folded[gs[i]]) {
                        hide = true;
                        break;
                    }
                }
                r.style.display = hide ? 'none' : '';
            });
        }

        function syncFoldBtn(tbl) {
            var btn = tbl.querySelector('.fold-all');
            if (!btn) return;
            var any = Array.prototype.some.call(tbl.querySelectorAll('tr.grp[data-gid]'), function (t) {
                return t.classList.contains('folded');
            });
            btn.textContent = any ? '展开全部' : '收起全部';
        }

        function setFoldAll(tbl, collapsed) {
            Array.prototype.forEach.call(tbl.querySelectorAll('tr.grp[data-gid]'), function (t) {
                t.classList.toggle('folded', collapsed);
            });
            recalcFold(tbl);
            syncFoldBtn(tbl);
        }

        // 首屏折叠状态：优先读用户上次偏好，否则按 AUTO_FOLD_DEPTH
        function applyFoldDefault() {
            var tables = document.querySelectorAll('table.tbl');
            var pref = localStorage.getItem('apidoc.fold|' + SPEC_URL);
            if (pref === '1' || pref === '0') {
                Array.prototype.forEach.call(tables, function (tbl) {
                    if (tbl.querySelector('tr.grp[data-gid]')) setFoldAll(tbl, pref === '0');
                });
                return;
            }
            Array.prototype.forEach.call(tables, function (tbl) {
                recalcFold(tbl);
                syncFoldBtn(tbl);
            });
        }

        /* ============ 调试区 ============ */
        function collectParams(op) {
            var list = (op.parameters || []).map(function (p) {
                return deref(p);
            });
            var path = [], query = [];
            list.forEach(function (p) {
                if (!p || !p.name) return;
                if (p.in === 'path') path.push(p);
                else if (p.in === 'query') query.push(p);
            });
            return {path: path, query: query, all: list};
        }

        function pathTemplateVars(path) {
            var out = [], re = /\{([^}]+)\}/g, m;
            while ((m = re.exec(path)) !== null) out.push(m[1]);
            return out;
        }

        function tryBlock(idx, path, method, params, bodySchema, contentType, hasBody) {
            var vars = pathTemplateVars(path);
            params.path.forEach(function (p) {
                if (vars.indexOf(p.name) < 0) vars.push(p.name);
            });
            var h = [];
            h.push('<div class="try collapsed" data-idx="' + idx + '">');
            h.push('<div class="try-h" data-act="toggle-try" data-idx="' + idx + '">' +
                '<span class="tl"><i class="caret"></i><span>在线调试</span>' +
                '<span class="badge auth" data-authbadge="' + idx + '"' + (needToken(idx) ? '' : ' style="display:none"') +
                '>携带 Token</span></span>' +
                '<span class="hint">' + (hasBody ? 'JSON 请求体' : '无请求体') + '</span></div>');
            h.push('<div class="try-b">');
            h.push('<div class="warn-tip" data-warn="' + idx + '">该接口标记为「需 Token」，发送时会自动带上顶部 Token；当前 Token 为空，可能返回 401。</div>');
            h.push('<div class="row"><label>请求地址</label><div class="ctl">' +
                '<input type="text" class="f-url" spellcheck="false" value="' + esc(path) + '">' +
                '<div class="tip">完整 URL = Base + 上面的路径，可直接修改</div></div></div>');
            vars.forEach(function (name) {
                h.push('<div class="row"><label>路径参数</label><div class="ctl">' +
                    '<input type="text" data-p="path" data-name="' + esc(name) + '" placeholder="' + esc(name) + '">' +
                    '<div class="tip">' + esc(name) + '<span class="req">*</span></div></div></div>');
            });
            params.query.forEach(function (p) {
                h.push('<div class="row"><label>Query</label><div class="ctl">' +
                    '<input type="text" data-p="query" data-name="' + esc(p.name) + '" placeholder="' +
                    esc(labelOf(p) || p.name) + '">' +
                    '<div class="tip">' + esc(p.name) + (p.required ? '<span class="req">*</span>' : '') +
                    (labelOf(p) ? ' · ' + esc(labelOf(p)) : '') + '</div></div></div>');
            });
            var hdr = {'Content-Type': contentType || 'application/json'};
            h.push('<div class="row"><label>请求头</label><div class="ctl">' +
                '<textarea class="f-headers" spellcheck="false">' + esc(JSON.stringify(hdr, null, 2)) + '</textarea>' +
                '<div class="tip">JSON 格式；填入上方 Token 后会自动追加 Authorization</div></div></div>');
            if (hasBody) {
                var bodyText = bodySchema ? JSON.stringify(sample(bodySchema), null, 2) : '{}';
                h.push('<div class="row"><label>请求体</label><div class="ctl">' +
                    '<textarea class="f-body" spellcheck="false">' + esc(bodyText) + '</textarea></div></div>');
            }
            h.push('<div class="acts">' +
                '<button class="btn" data-act="send" data-idx="' + idx + '">发送请求</button>' +
                '<button class="btn ghost" data-act="fill" data-idx="' + idx + '">填充示例</button>' +
                '</div>');
            h.push('<div class="resp"><div class="resp-meta"></div><pre class="resp-body"></pre></div>');
            h.push('</div></div>');
            return h.join('');
        }

        /* ============ 渲染接口 ============ */
        function renderApi(item, index) {
            var path = item.path, method = item.method, op = item.op;
            var params = collectParams(op);
            META[index] = {path: path, method: method, op: op, hasBody: false};
            var needAuth = needToken(index);
            var html = [];
            html.push('<section class="api" id="api-' + index + '">');
            html.push('<h2 class="api-title" data-act="toggle-api" data-idx="' + index + '">' +
                '<i class="caret"></i>' +
                '<span class="m ' + method + '">' + method.toUpperCase() + '</span>' +
                '<span class="api-name">' + esc(op.summary || path) + '</span>' +
                '<span class="path">' + esc(path) + '</span>' +
                '<span class="api-right">' +
                '<span class="badge auth"' + (needAuth ? '' : ' style="display:none"') + '>需 Token</span>' +
                '<label class="auth-tog" title="该接口调用时是否注入 Authorization">' +
                '<input type="checkbox" data-act="auth" data-idx="' + index + '"' + (needAuth ? ' checked' : '') + '>' +
                '需 Token</label>' +
                '</span></h2>');
            html.push('<div class="api-body">');
            if (op.description) html.push('<p class="desc">' + esc(op.description) + '</p>');
            /* 公共参数 */
            var contentType = 'application/json';
            var bodySchema = null;
            var rb = null;
            if (op.requestBody) {
                rb = deref(op.requestBody);
                var content = rb.content || {};
                var ct = Object.keys(content)[0];
                if (ct) {
                    contentType = ct;
                    bodySchema = deref(content[ct].schema || {});
                }
            }
            var headerParams = params.all.filter(function (p) {
                return p.in === 'header';
            });
            var auth = Array.isArray(op.security) && op.security.length ? 'Bearer {token}' : '';
            html.push('<table class="tbl"><colgroup><col style="width:150px"><col></colgroup>');
            html.push('<tr class="thead"><td colspan="2">公共参数</td></tr>');
            html.push('<tr><td class="lb">请求地址</td><td class="code">' + esc(path) + '</td></tr>');
            html.push('<tr><td class="lb">请求类型</td><td>' + esc(method) + '</td></tr>');
            html.push('<tr class="thead"><td colspan="2">请求头信息</td></tr>');
            html.push('<tr class="th"><td class="lb">参数</td><td>值</td></tr>');
            html.push('<tr><td>Content-Type</td><td class="code">' + esc(contentType) + '</td></tr>');
            headerParams.forEach(function (p) {
                var v = exampleOf(p) || (p.schema ? exampleOf(p.schema) : '') || esc(labelOf(p));
                html.push('<tr><td>' + esc(p.name) + '</td><td class="code">' + v + '</td></tr>');
            });
            if (auth) html.push('<tr><td>Authorization</td><td class="code">' + esc(auth) + '</td></tr>');
            html.push('</table>');
            /* 请求参数 */
            var reqRows = [];
            params.all.filter(function (p) {
                return p.in !== 'header';
            }).forEach(function (p) {
                var sch = deref(p.schema || {});
                var required = p.required === true || p.in === 'path';
                reqRows.push('<tr>' +
                    '<td>' + esc(p.name) + '</td>' +
                    '<td>' + (typeLabel(sch) || '<span class="muted">—</span>') + '</td>' +
                    '<td>' + (required ? '是' : '否') + '</td>' +
                    '<td>' + (maxLenOf(sch) || '') + '</td>' +
                    descCell(esc(labelOf(p) || (p.in === 'path' ? '路径参数' : '查询参数'))) +
                    '<td>' + (exampleOf(sch) || '') + '</td>' +
                    '</tr>');
            });
            var hasBody = false;
            if (bodySchema && Object.keys(bodySchema.properties || {}).length) {
                hasBody = true;
                schemaRows(bodySchema, 'request', 0, reqRows, bodySchema.required || []);
            } else if (bodySchema && bodySchema.type === 'array') {
                hasBody = true;
                var it0 = deref(bodySchema.items || {});
                reqRows.push('<tr><td>body<span class="muted">（数组）</span></td><td>' +
                    (typeLabel(bodySchema) || 'array') + '</td><td>' + (rb && rb.required ? '是' : '否') +
                    '</td><td></td><td>请求体（JSON 数组）</td><td></td></tr>');
                if (it0.properties) {
                    var ga = 'g' + (++GID);
                    reqRows.push('<tr class="grp folded" data-act="toggle-grp" data-gid="' + ga + '">' +
                        '<td colspan="6"><span class="grp-l"><i class="caret"></i><span class="gname">数组元素结构</span>' +
                        '<span class="cnt">' + Object.keys(it0.properties).length + ' 项</span></span></td></tr>');
                    schemaRows(it0, 'request', 1, reqRows, it0.required || [], [], [ga]);
                }
            } else if (op.requestBody) {
                hasBody = true;
            }
            if (reqRows.length) {
                html.push('<table class="tbl"><colgroup>' +
                    '<col style="width:17%"><col style="width:13%"><col style="width:9%"><col style="width:9%">' +
                    '<col style="width:31%"><col style="width:21%"></colgroup>');
                html.push('<tr class="thead"><td colspan="6">请求参数' +
                    foldAllBtn(reqRows) + '</td></tr>');
                html.push('<tr class="th"><td>参数</td><td>类型</td><td>是否必填</td><td>最大长度</td><td>描述</td><td>示例值</td></tr>');
                html.push(reqRows.join(''));
                html.push('</table>');
            }
            /* 响应结构 */
            var responses = op.responses || {};
            var codes = Object.keys(responses);
            if (codes.length) {
                var okCodes = codes.filter(function (c) {
                    return /^2/.test(c);
                });
                var ordered = okCodes.concat(codes.filter(function (c) {
                    return okCodes.indexOf(c) < 0;
                }));
                var multi = ordered.length > 1;
                var respRows = [];
                ordered.forEach(function (code) {
                    var r = deref(responses[code] || {});
                    var content = r.content || {};
                    var ct = Object.keys(content)[0];
                    var sch = ct ? deref(content[ct].schema || {}) : null;
                    if (multi) {
                        respRows.push('<tr class="grp"><td colspan="5">HTTP ' + esc(code) +
                            (r.description ? '<span class="note">' + esc(r.description) + '</span>' : '') + '</td></tr>');
                    }
                    if (sch && sch.type === 'array') {
                        var it1 = deref(sch.items || {});
                        respRows.push('<tr><td>data<span class="muted">（数组）</span></td><td>' + (typeLabel(sch) || 'array') +
                            '</td><td>—</td><td>' + esc(labelOf(sch)) + '</td><td></td></tr>');
                        if (it1.properties) {
                            var gb = 'g' + (++GID);
                            respRows.push('<tr class="grp folded" data-act="toggle-grp" data-gid="' + gb + '">' +
                                '<td colspan="5"><span class="grp-l"><i class="caret"></i><span class="gname">数组元素结构</span>' +
                                '<span class="cnt">' + Object.keys(it1.properties).length + ' 项</span></span></td></tr>');
                            schemaRows(it1, 'response', 1, respRows, it1.required || [], [], [gb]);
                        }
                    } else if (sch && Object.keys(sch.properties || {}).length) {
                        schemaRows(sch, 'response', 0, respRows, sch.required || []);
                    } else if (r.description) {
                        respRows.push('<tr><td colspan="5">' + esc(r.description) + '</td></tr>');
                    }
                });
                var firstDesc = '';
                if (!multi) {
                    var r0 = deref(responses[ordered[0]] || {});
                    firstDesc = ordered[0] + (r0.description ? ' · ' + r0.description : '');
                }
                html.push('<table class="tbl"><colgroup>' +
                    '<col style="width:19%"><col style="width:13%"><col style="width:9%"><col style="width:34%"><col style="width:25%"></colgroup>');
                html.push('<tr class="thead"><td colspan="5">响应结构' +
                    (firstDesc ? '<span class="note">' + esc(firstDesc) + '</span>' : '') +
                    foldAllBtn(respRows) + '</td></tr>');
                html.push('<tr class="th"><td>参数</td><td>类型</td><td>是否必须</td><td>描述</td><td>示例值</td></tr>');
                html.push(respRows.join(''));
                html.push('</table>');
            }
            /* 在线调试 */
            html.push(tryBlock(index, path, method, params, bodySchema, contentType, hasBody));
            html.push('</div></section>');
            META[index].hasBody = hasBody;
            return html.join('');
        }

        /* ============ 构建 ============ */
        function build() {
            var doc = document.getElementById('doc');
            var nav = document.getElementById('nav');
            LIST = [];
            META = {};
            var paths = SPEC.paths || {};
            Object.keys(paths).forEach(function (path) {
                var item = paths[path];
                METHODS.forEach(function (m) {
                    if (item && item[m]) {
                        LIST.push({
                            path: path, method: m, op: item[m],
                            tag: (item[m].tags && item[m].tags[0]) || '默认分组'
                        });
                    }
                });
            });
            if (!LIST.length) {
                doc.innerHTML = '<div class="empty">未发现任何接口（' + esc(SPEC_URL) + '）。</div>';
                return;
            }
            var groups = [], map = {};
            LIST.forEach(function (it) {
                if (!map[it.tag]) {
                    map[it.tag] = [];
                    groups.push(it.tag);
                }
                map[it.tag].push(it);
            });
            var navHtml = [], docHtml = [], idx = 0;
            groups.forEach(function (tag) {
                var items = map[tag];
                var body = [];
                navHtml.push('<div class="tag" data-act="toggle-tag" data-tag="' + esc(tag) + '">' +
                    '<i class="caret"></i><span class="t">' + esc(tag) + '</span>' +
                    '<span class="g-count">' + items.length + '</span></div>');
                items.forEach(function (it) {
                    navHtml.push('<a href="#api-' + idx + '" data-idx="' + idx + '" data-tag="' + esc(tag) + '">' +
                        '<i class="dot ' + it.method + '"></i><span class="t">' + esc(it.op.summary || it.path) + '</span></a>');
                    body.push(renderApi(it, idx));
                    idx++;
                });
                docHtml.push('<div class="group" data-tag="' + esc(tag) + '">' +
                    '<div class="group-h" data-act="toggle-tag" data-tag="' + esc(tag) + '">' +
                    '<i class="caret"></i><span class="g-name">' + esc(tag) + '</span>' +
                    '<span class="g-count">' + items.length + '</span></div>' +
                    '<div class="group-b">' + body.join('') + '</div></div>');
            });
            nav.innerHTML = navHtml.join('');
            doc.innerHTML = docHtml.join('');
            document.getElementById('ver').textContent =
                (SPEC.info && SPEC.info.title ? SPEC.info.title + ' · ' : '') +
                (SPEC.info && SPEC.info.version ? 'v' + SPEC.info.version : '');
            document.getElementById('desc').textContent = (SPEC.info && SPEC.info.description) || '';
            applyDefaults();
            syncLayoutBtn();
            restoreUI();
            bindNav();
            var hash = location.hash;
            if (hash && /^#api-\d+$/.test(hash)) {
                revealApi(parseInt(hash.slice(5), 10));
                var el = document.getElementById(hash.slice(1));
                if (el) window.scrollTo(0, Math.max(0, el.offsetTop - 70));
            }
        }

        /* ============ 折叠状态 ============ */
        function uiKey(kind, id) {
            return 'apidoc.ui|' + SPEC_URL + '|' + kind + '|' + id;
        }

        function apiKeyOf(idx) {
            var m = META[idx];
            return m ? (m.method + ' ' + m.path) : '';
        }

        // 接口是否需要 Token：手动设置优先 > op.security > 全局 security > 按文档默认
        // 这里也是文件名，和 DOCS 保持一致
        var DEFAULT_AUTH_DOCS = ['admin.json'];

        function defaultToken(idx) {
            var m = META[idx];
            if (!m) return false;
            var op = m.op || {};
            if (Array.isArray(op.security)) return op.security.length > 0;
            if (Array.isArray(SPEC.security)) return SPEC.security.length > 0;
            return DEFAULT_AUTH_DOCS.some(function (f) {
                return docUrl(f) === SPEC_URL;
            });
        }

        function needToken(idx) {
            var v = localStorage.getItem('apidoc.auth|' + SPEC_URL + '|' + apiKeyOf(idx));
            if (v === '1') return true;
            if (v === '0') return false;
            return defaultToken(idx);
        }

        function findGroup(tag) {
            var list = document.querySelectorAll('.group');
            for (var i = 0; i < list.length; i++) {
                if (list[i].dataset.tag === tag) return list[i];
            }
            return null;
        }

        function findNavTag(tag) {
            var list = document.querySelectorAll('#nav .tag');
            for (var i = 0; i < list.length; i++) {
                if (list[i].dataset.tag === tag) return list[i];
            }
            return null;
        }

        function syncNavTag(tag, collapsed) {
            var el = findNavTag(tag);
            if (!el) return;
            el.classList.toggle('collapsed', collapsed);
            var n = el.nextElementSibling;
            while (n && !n.classList.contains('tag')) {
                if (!n.dataset.navHidden) n.style.display = collapsed ? 'none' : '';
                n = n.nextElementSibling;
            }
        }

        function setGroup(tag, collapsed, persist) {
            var g = findGroup(tag);
            if (g) g.classList.toggle('collapsed', collapsed);
            syncNavTag(tag, collapsed);
            if (persist) localStorage.setItem(uiKey('g', tag), collapsed ? '0' : '1');
        }

        function setApi(idx, collapsed, persist) {
            var sec = document.getElementById('api-' + idx);
            if (sec) sec.classList.toggle('collapsed', collapsed);
            if (persist) localStorage.setItem(uiKey('a', apiKeyOf(idx)), collapsed ? '0' : '1');
        }

        function revealApi(idx) {
            var sec = document.getElementById('api-' + idx);
            if (!sec) return;
            sec.style.display = '';
            setApi(idx, false, false);
            var g = sec.closest('.group');
            if (g) {
                g.style.display = '';
                setGroup(g.dataset.tag, false, false);
            }
        }

        function resetUI() {
            Array.prototype.forEach.call(document.querySelectorAll('.group'), function (g) {
                g.classList.remove('collapsed');
                g.style.display = '';
            });
            Array.prototype.forEach.call(document.querySelectorAll('.api'), function (s) {
                s.classList.remove('collapsed');
                s.style.display = '';
            });
            Array.prototype.forEach.call(document.querySelectorAll('#nav .tag'), function (t) {
                t.classList.remove('collapsed');
                t.style.display = '';
            });
            Array.prototype.forEach.call(document.querySelectorAll('#nav a'), function (a) {
                a.style.display = '';
            });
        }

        function restoreUI() {
            Array.prototype.forEach.call(document.querySelectorAll('.group'), function (g) {
                if (localStorage.getItem(uiKey('g', g.dataset.tag)) === '0') {
                    g.classList.add('collapsed');
                    syncNavTag(g.dataset.tag, true);
                }
            });
            Object.keys(META).forEach(function (i) {
                if (localStorage.getItem(uiKey('a', apiKeyOf(i))) === '0') {
                    var sec = document.getElementById('api-' + i);
                    if (sec) sec.classList.add('collapsed');
                }
            });
            applyFoldDefault();
        }

        function syncLayoutBtn() {
            var b = document.getElementById('layoutBtn');
            if (!b) return;
            var full = document.documentElement.classList.contains('full');
            b.textContent = full ? '居中' : '全屏';
            b.title = full ? '恢复居中布局（内容最大 1200px）' : '内容铺满窗口宽度';
        }

        function syncAuthBadges(idx, need) {
            var sec = document.getElementById('api-' + idx);
            if (sec) {
                var badge = sec.querySelector('.api-right .badge.auth');
                if (badge) badge.style.display = need ? 'inline-block' : 'none';
            }
            var box = document.querySelector('.try[data-idx="' + idx + '"]');
            if (box) {
                var b2 = box.querySelector('[data-authbadge]');
                if (b2) b2.style.display = need ? 'inline-block' : 'none';
            }
        }

        // Base 按文档分别记忆：同一份 spec 里有多个 server 时可直接从下拉选
        function baseKey() {
            return 'apidoc.base|' + SPEC_URL;
        }

        function specServers() {
            var arr = (SPEC && Array.isArray(SPEC.servers)) ? SPEC.servers : [];
            return arr.filter(function (s) {
                return s && s.url;
            });
        }

        // 实际使用的服务地址（只取下拉选中值）
        function baseValue() {
            var v = document.getElementById('base').value;
            return (v || '').trim().replace(/\/+$/, '');
        }

        function fillBaseSelect() {
            var sel = document.getElementById('base');
            var sv = specServers();
            var saved = localStorage.getItem(baseKey()) || '';
            var legacy = localStorage.getItem(LS_BASE) || '';
            var opts = [], seen = {};
            sv.forEach(function (s) {
                if (seen[s.url]) return;
                seen[s.url] = 1;
                opts.push({v: s.url, t: s.url + (s.description ? ' - ' + s.description : '')});
            });
            if (!opts.length) {
                opts.push({v: 'http://127.0.0.1:9501', t: 'http://127.0.0.1:9501'});
                seen['http://127.0.0.1:9501'] = 1;
            }
            // 记忆的地址若已不在 servers 列表，退回第一个，不再走自定义输入
            var cur = seen[saved] ? saved : (seen[legacy] ? legacy : opts[0].v);
            sel.innerHTML = opts.map(function (o) {
                return '<option value="' + esc(o.v) + '">' + esc(o.t) + '</option>';
            }).join('');
            sel.value = cur;
            sel.title = '本文档共 ' + opts.length + ' 个服务地址' +
                (opts.length > 1 ? '，可切换' : '');
        }

        function applyDefaults() {
            fillBaseSelect();
            var tokenEl = document.getElementById('token');
            tokenEl.value = localStorage.getItem(LS_TOKEN) || '';
            // 每个接口的 URL 前面补 Base 展示
            Object.keys(META).forEach(function (i) {
                var box = document.querySelector('.try[data-idx="' + i + '"]');
                if (!box) return;
                var inp = box.querySelector('.f-url');
                if (inp && inp.value === META[i].path) {
                    inp.dataset.auto = '1';
                }
            });
        }

        function bindNav() {
            var links = Array.prototype.slice.call(document.querySelectorAll('#nav a'));
            links.forEach(function (a) {
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    var ai = Number(a.dataset.idx);
                    revealApi(ai);
                    var el = document.getElementById('api-' + ai);
                    if (el) {
                        window.scrollTo({
                            top: el.getBoundingClientRect().top + window.scrollY - 56,
                            behavior: 'smooth'
                        });
                        history.replaceState(null, '', a.getAttribute('href'));
                    }
                });
            });
            var ticking = false;
            window.addEventListener('scroll', function () {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(function () {
                    ticking = false;
                    var pos = window.scrollY + 80, cur = null;
                    links.forEach(function (a) {
                        var el = document.getElementById('api-' + a.dataset.idx);
                        if (el && el.offsetTop <= pos) cur = a;
                    });
                    links.forEach(function (a) {
                        a.classList.toggle('active', a === cur);
                    });
                });
            });
            var q = document.getElementById('q');
            q.addEventListener('input', function () {
                var kw = q.value.trim().toLowerCase();
                if (kw === '') {
                    resetUI();
                    restoreUI();
                    return;
                }
                // 搜索时先全部展开
                Array.prototype.forEach.call(document.querySelectorAll('.group'), function (g) {
                    g.classList.remove('collapsed');
                    g.style.display = '';
                    syncNavTag(g.dataset.tag, false);
                });
                Array.prototype.forEach.call(document.querySelectorAll('.api'), function (s) {
                    s.classList.remove('collapsed');
                });
                links.forEach(function (a) {
                    var it = LIST[a.dataset.idx];
                    var hay = (it.path + ' ' + (it.op.summary || '') + ' ' + it.method + ' ' + it.tag).toLowerCase();
                    var hit = hay.indexOf(kw) > -1;
                    a.style.display = hit ? '' : 'none';
                    var sec = document.getElementById('api-' + a.dataset.idx);
                    if (sec) sec.style.display = hit ? '' : 'none';
                });
                // 无命中项的分组整体隐藏
                Array.prototype.forEach.call(document.querySelectorAll('.group'), function (g) {
                    var any = false;
                    Array.prototype.forEach.call(g.querySelectorAll('.api'), function (s) {
                        if (s.style.display !== 'none') any = true;
                    });
                    g.style.display = any ? '' : 'none';
                });
                Array.prototype.forEach.call(document.querySelectorAll('#nav .tag'), function (t) {
                    var any = false, n = t.nextElementSibling;
                    while (n && !n.classList.contains('tag')) {
                        if (n.style.display !== 'none') {
                            any = true;
                            break;
                        }
                        n = n.nextElementSibling;
                    }
                    t.style.display = any ? '' : 'none';
                });
            });
        }

        /* ============ 发送请求 ============ */
        function box(idx) {
            return document.querySelector('.try[data-idx="' + idx + '"]');
        }

        function fullUrl(b) {
            var base = baseValue();
            var p = b.querySelector('.f-url').value.trim();
            if (/^https?:\/\//i.test(p)) return p;
            if (!p.startsWith('/')) p = '/' + p;
            return base + p;
        }

        function setResp(b, cls, statusText, ms, bodyHtml) {
            var resp = b.querySelector('.resp');
            resp.style.display = 'block';
            resp.querySelector('.resp-meta').innerHTML =
                '<span class="st ' + cls + '">' + esc(statusText) + '</span>' +
                '<span>' + ms + ' ms</span>' +
                '<button class="btn ghost mini" data-act="copy">复制</button>';
            resp.querySelector('.resp-body').innerHTML = bodyHtml;
        }

        function send(btn) {
            var idx = btn.dataset.idx;
            var b = box(idx);
            if (!b) return;
            var meta = META[idx];
            var url = fullUrl(b);
            // 路径参数
            Array.prototype.forEach.call(b.querySelectorAll('[data-p="path"]'), function (inp) {
                var v = inp.value.trim();
                if (v !== '') url = url.replace('{' + inp.dataset.name + '}', encodeURIComponent(v));
            });
            // Query
            var qs = [];
            Array.prototype.forEach.call(b.querySelectorAll('[data-p="query"]'), function (inp) {
                if (inp.value.trim() === '') return;
                qs.push(encodeURIComponent(inp.dataset.name) + '=' + encodeURIComponent(inp.value.trim()));
            });
            if (qs.length) url += (url.indexOf('?') > -1 ? '&' : '?') + qs.join('&');
            // 请求头
            var headers = {};
            try {
                headers = JSON.parse(b.querySelector('.f-headers').value || '{}');
            } catch (e) {
                setResp(b, 'err', '请求头无效', 0, '请填写合法的 JSON，例如：\n{\n  "Content-Type": "application/json"\n}');
                return;
            }
            var token = document.getElementById('token').value.trim();
            var hasAuth = Object.keys(headers).some(function (k) {
                return k.toLowerCase() === 'authorization';
            });
            // 只有被标记为「需 Token」的接口才注入 Authorization
            if (needToken(idx) && token && !hasAuth) {
                headers.Authorization = /^bearer\s/i.test(token) ? token : 'Bearer ' + token;
            }
            updateTokenHint(idx);
            var opt = {method: meta.method.toUpperCase(), headers: headers, mode: 'cors'};
            var ta = b.querySelector('.f-body');
            if (ta && ta.value.trim() !== '' && ['GET', 'HEAD'].indexOf(opt.method) < 0) {
                opt.body = ta.value;
            }
            btn.disabled = true;
            var old = btn.textContent;
            btn.textContent = '发送中…';
            var t0 = (window.performance && performance.now) ? performance.now() : Date.now();
            fetch(url, opt).then(function (res) {
                return res.text().then(function (text) {
                    var ms = Math.round(((window.performance && performance.now) ? performance.now() : Date.now()) - t0);
                    var pretty = text;
                    try {
                        pretty = JSON.stringify(JSON.parse(text), null, 2);
                    } catch (e) { /* 非 JSON 原样输出 */
                    }
                    var cls = res.status >= 500 ? 'err' : res.status >= 400 ? 'warn' : res.status >= 300 ? 'redir' : 'ok';
                    var ct = res.headers.get('content-type') || '';
                    setResp(b, cls, res.status + ' ' + (res.statusText || ''), ms,
                        '<span style="color:#98a2b3">' + esc(ct) + '\n</span>' + esc(pretty.slice(0, 200000)));
                });
            }).catch(function (err) {
                var ms = Math.round(((window.performance && performance.now) ? performance.now() : Date.now()) - t0);
                setResp(b, 'err', '请求失败', ms,
                    '<div class="err-tip">' + esc(err && err.message ? err.message : String(err)) +
                    // '<br>' +
                    // '可能原因：<br>' +
                    // '1. 业务端口未允许跨域 —— 文档页与接口不同源，需服务端返回 <code>Access-Control-Allow-Origin</code> 并放行 <code>OPTIONS</code> 预检；<br>' +
                    // '2. 服务未启动或地址不可达（当前请求：' + esc(url) + '）；<br>' +
                    // '3. HTTPS 页面调用 HTTP 接口被浏览器拦截。
                    '</div>');
            }).then(function () {
                btn.disabled = false;
                btn.textContent = old;
            });
        }

        /* ============ 事件委托 ============ */
        document.addEventListener('click', function (e) {
            // 「需 Token」复选框不触发折叠
            if (e.target.closest('.auth-tog')) return;
            var el = e.target.closest('[data-act]');
            if (!el) return;
            var act = el.dataset.act;
            if (act === 'toggle-api') {
                var ai = Number(el.dataset.idx);
                var secEl = document.getElementById('api-' + ai);
                if (secEl) setApi(ai, !secEl.classList.contains('collapsed'), true);
                return;
            }
            if (act === 'toggle-try') {
                var boxEl = el.closest('.try');
                if (boxEl) {
                    boxEl.classList.toggle('collapsed');
                    if (!boxEl.classList.contains('collapsed')) updateTokenHint(Number(el.dataset.idx));
                }
                return;
            }
            if (act === 'toggle-tag') {
                var tg = el.dataset.tag;
                var gEl = findGroup(tg);
                setGroup(tg, !(gEl && gEl.classList.contains('collapsed')), true);
                return;
            }
            // 居中 / 全屏 布局切换
            if (act === 'toggle-layout') {
                var isFull = document.documentElement.classList.toggle('full');
                try {
                    localStorage.setItem('apidoc.layout', isFull ? 'full' : 'center');
                } catch (err) {
                }
                syncLayoutBtn();
                return;
            }
            if (act === 'expand-all' || act === 'collapse-all') {
                var col = act === 'collapse-all';
                Array.prototype.forEach.call(document.querySelectorAll('.group'), function (g) {
                    setGroup(g.dataset.tag, col, true);
                });
                Object.keys(META).forEach(function (i) {
                    setApi(Number(i), col, true);
                });
                Array.prototype.forEach.call(document.querySelectorAll('table.tbl'), function (tbl) {
                    if (tbl.querySelector('tr.grp[data-gid]')) setFoldAll(tbl, col);
                });
                localStorage.setItem('apidoc.fold|' + SPEC_URL, col ? '0' : '1');
                return;
            }
            // 参数表内：某个嵌套结构的展开/收起
            if (act === 'toggle-grp') {
                var tbl1 = el.closest('table');
                el.classList.toggle('folded');
                if (tbl1) {
                    recalcFold(tbl1);
                    syncFoldBtn(tbl1);
                }
                return;
            }
            // 参数表内：整表展开/收起
            if (act === 'fold-table') {
                var tbl2 = el.closest('table');
                if (!tbl2) return;
                // 按按钮文案执行：有折叠的 → 全部展开；否则全部收起
                var anyFolded = Array.prototype.some.call(tbl2.querySelectorAll('tr.grp[data-gid]'), function (t) {
                    return t.classList.contains('folded');
                });
                setFoldAll(tbl2, !anyFolded);
                localStorage.setItem('apidoc.fold|' + SPEC_URL, anyFolded ? '1' : '0');
                return;
            }
            // 描述列过长时的展开/收起
            if (act === 'toggle-desc') {
                var cell = el.closest('.dcell');
                if (!cell) return;
                var open = cell.classList.toggle('open');
                var more = cell.querySelector('.dmore');
                if (more) more.textContent = open ? '收起' : '展开';
                return;
            }
            if (act === 'send') {
                send(el);
                return;
            }
            if (act === 'fill') {
                var b = box(el.dataset.idx);
                var meta = META[el.dataset.idx];
                var op = LIST[el.dataset.idx].op;
                var rb = op.requestBody ? deref(op.requestBody) : null;
                var content = rb ? (rb.content || {}) : {};
                var ct = Object.keys(content)[0];
                var sch = ct ? deref(content[ct].schema || {}) : null;
                var ta = b.querySelector('.f-body');
                if (ta && sch) ta.value = JSON.stringify(sample(sch), null, 2);
                b.querySelector('.f-url').value = meta.path;
                return;
            }
            if (act === 'copy') {
                var pre = el.closest('.resp').querySelector('.resp-body');
                var text = pre.textContent || '';
                if (navigator.clipboard) {
                    navigator.clipboard.writeText(text).then(function () {
                        el.textContent = '已复制';
                        setTimeout(function () {
                            el.textContent = '复制';
                        }, 1200);
                    });
                }
                return;
            }
        });
        // 「需 Token」勾选
        document.addEventListener('change', function (e) {
            var cb = e.target;
            if (!cb || !cb.matches('input[data-act="auth"]')) return;
            var i = Number(cb.dataset.idx);
            var on = cb.checked;
            localStorage.setItem('apidoc.auth|' + SPEC_URL + '|' + apiKeyOf(i), on ? '1' : '0');
            syncAuthBadges(i, on);
            updateTokenHint(i);
        });

        function updateTokenHint(idx) {
            var bx = document.querySelector('.try[data-idx="' + idx + '"]');
            if (!bx) return;
            var w = bx.querySelector('[data-warn]');
            if (!w) return;
            w.style.display = (needToken(idx) && !document.getElementById('token').value.trim()) ? 'block' : 'none';
        }

        // Base / Token 持久化（Base 按文档分开存，切文档互不覆盖）
        document.getElementById('base').addEventListener('change', function () {
            localStorage.setItem(baseKey(), this.value.trim());
        });
        document.getElementById('token').addEventListener('change', function () {
            localStorage.setItem(LS_TOKEN, this.value.trim());
        });
        document.getElementById('token').addEventListener('input', function () {
            Object.keys(META).forEach(function (i) {
                updateTokenHint(Number(i));
            });
        });

        /* ============ 文档切换 ============ */
        function initDocSelect() {
            var sel = document.getElementById('docSel');
            DOCS.forEach(function (d) {
                var o = document.createElement('option');
                o.value = docUrl(d);
                o.textContent = docName(d);
                o.title = docUrl(d);
                if (docUrl(d) === SPEC_URL) o.selected = true;
                sel.appendChild(o);
            });
            if (!DOCS.some(function (d) {
                return docUrl(d) === SPEC_URL;
            })) {
                var o2 = document.createElement('option');
                o2.value = SPEC_URL;
                o2.textContent = SPEC_URL;
                o2.selected = true;
                sel.appendChild(o2);
            }
            sel.addEventListener('change', function () {
                location.href = location.pathname + '?spec=' + encodeURIComponent(this.value);
            });
        }

        /* ============ 加载 ============ */
        var qs = new URLSearchParams(location.search);
        SPEC_URL = docUrl(qs.get('spec') || qs.get('search') || DOCS[0] || 'api.json');

        function init() {
            fetch(SPEC_URL, {headers: {Accept: 'application/json'}})
            .then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.json();
            })
            .then(function (json) {
                SPEC = json;
                initDocSelect();
                build();
            })
            .catch(function (e) {
                // SPEC = DEMO;
                initDocSelect();
                document.getElementById('doc').insertAdjacentHTML('afterbegin',
                    '<div class="title">Failed to load API definition.</div><div class="bucket">Not Found  ' + esc(SPEC_URL) + '（' + esc(e.message) + '）。</div>');
            });
        }

        init();
    })();
</script>
</body>
</html>
